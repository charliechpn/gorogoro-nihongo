{
  "name": "nihongo-study",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "data:kanji": "node scripts/export-kanji-data.mjs",
    "data:verbs": "python scripts/export-transitivity-data.py",
    "db:generate": "drizzle-kit generate",
    "db:seed:kanji": "node scripts/append-kanji-seed.mjs",
    "db:migrate:local": "wrangler d1 migrations apply site-creator-d1 --local --config wrangler.jsonc",
    "test:deck": "node --test app/treino/kanji/deck.test.ts",
    "test:kanji-backend": "node --test app/api/kanji/backend.test.ts",
    "test:words": "node --test app/treino/palavras/game.test.ts",
    "test:onomatopoeia": "node --test app/treino/onomatopeias/game.test.ts",
    "test:verbs": "node --test app/treino/verbos/game.test.ts",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
